{
  "name": "partbin",
  "version": "0.1.0",
  "description": "PartBin · 硬件出入库系统",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm --filter @partbin/web run build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/src/index.js",
    "test": "pnpm --filter @partbin/server run test",
    "privacy:check": "node scripts/privacy-scan.js",
    "backup": "node --disable-warning=ExperimentalWarning server/scripts/backup.js",
    "restore": "node --disable-warning=ExperimentalWarning server/scripts/restore.js",
    "backup:verify": "node --disable-warning=ExperimentalWarning server/scripts/restore-drill.js",
    "db:check": "node --disable-warning=ExperimentalWarning server/scripts/db-check.js",
    "db:reconcile": "node --disable-warning=ExperimentalWarning server/scripts/db-reconcile.js",
    "security:check": "node --disable-warning=ExperimentalWarning server/scripts/security-check.js",
    "seed:demo": "node --disable-warning=ExperimentalWarning server/scripts/seed-demo.js",
    "admin:create": "node --disable-warning=ExperimentalWarning server/scripts/create-admin.js",
    "release:check": "pnpm test && pnpm privacy:check",
    "prepare": "git config core.hooksPath .githooks || true"
  }
}
