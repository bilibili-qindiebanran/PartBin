# 监听地址：本地开发 127.0.0.1；需要局域网直连时改为 0.0.0.0（生产环境由 Caddy 反代，保持 127.0.0.1）
HOST=127.0.0.1
PORT=8787

# 数据目录：SQLite、照片与备份都在这里
DATA_DIR=./data

# 会话有效期（天）
SESSION_DAYS=30

# 仅 HTTPS 环境设为 true；本机纯 HTTP 调试用 false
COOKIE_SECURE=false

# 是否信任一层反向代理（本地调试 false；Caddy 前置时 true）
TRUST_PROXY=false

# 「本月」统计与默认时间显示时区
APP_TZ=Asia/Shanghai

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 备份保留份数
BACKUP_KEEP=14
