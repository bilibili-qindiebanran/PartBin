# 监听地址：生产环境由 Caddy / Cloudflare Tunnel 反代，保持 127.0.0.1
HOST=127.0.0.1
PORT=8787

# 数据目录：SQLite、照片与备份都在这里
DATA_DIR=./data

# 生产环境必填：至少 32 字节随机值；同时用于 TOTP 加密与 IP 哈希
# 生成示例：openssl rand -base64 48
APP_SECRET=

# 生产环境必填：站点公开地址，例如 https://partbin.example.com
PUBLIC_ORIGIN=

# 空闲会话有效期（天）与绝对有效期（天）
SESSION_DAYS=7
SESSION_ABSOLUTE_DAYS=30

# 仅 HTTPS 环境设为 true；生产环境默认 true
COOKIE_SECURE=true

# HSTS max-age（秒）；确认 HTTPS 稳定后再逐步提高
HSTS_MAX_AGE=86400

# 反向代理前置时设为 true（Cloudflare Tunnel / Caddy）
TRUST_PROXY=false

# 「本月」统计与默认时间显示时区
APP_TZ=Asia/Shanghai

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 备份保留份数（M7 使用）
BACKUP_KEEP=14
